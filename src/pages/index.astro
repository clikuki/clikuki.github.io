---
import Hero from "../components/hero.astro";
import ProjectList from "../components/projectList.astro";
---

<!DOCTYPE html>
<html lang="en">
<head>
	<meta charset="UTF-8"/>
	<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
	<meta name="generator" content={Astro.generator}/>
	<title>Clikuki's Space</title>
	<link rel="preload" href="/fonts/open-sans-v44-latin-regular.woff2" as="font" type="font/woff2" crossorigin>
	<link rel="preload" href="/fonts/open-sans-v44-latin-700.woff2" as="font" type="font/woff2" crossorigin>
</head>
<body>
	<Hero />
	<ProjectList />
</body>
</html>

<style>
	/* open-sans-regular - latin */
	@font-face {
		font-display: swap;
		font-family: 'Open Sans';
		font-style: normal;
		font-weight: 400;
		src: url('../fonts/open-sans-v44-latin-regular.woff2') format('woff2');
	}

	/* open-sans-700 - latin */
	@font-face {
		font-display: swap;
		font-family: 'Open Sans';
		font-style: normal;
		font-weight: 700;
		src: url('../fonts/open-sans-v44-latin-700.woff2') format('woff2');
	}

	:root {
		--white: #F3E9DC;
		--darker: #C75D2C;
		--dark: #D96F32;
		--light: #F8B259;

		scrollbar-color: var(--darker) var(--light);
		scrollbar-width: thin;
  	scroll-behavior: smooth;
		overflow-x: hidden;
	}

	body {
		font-family: "Open Sans", Arial, sans-serif;
		font-optical-sizing: auto;
		font-weight: normal;
		font-style: normal;
		font-variation-settings: "wdth" 100;

		margin: 0;
		background-color: var(--darker);
	}

	:global(*, ::before, ::after) {
		box-sizing: border-box;
	}
</style>